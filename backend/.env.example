CN_ENVIRONMENT=development
CN_JWT_SECRET_KEY=change-me-to-a-random-secret

# Option A — running `mongod` directly on your own machine with no auth
# configured (the default if you just installed MongoDB Community and ran
# `mongod`). Fine for local development only; never use this for anything
# reachable from outside your machine.
CN_MONGO_URI=mongodb://localhost:27017

# Option B — running Mongo via `docker compose up` (docker/docker-compose.yml),
# which now requires a username/password (see docker/.env.example). Comment
# out the line above and uncomment this one, using the same credentials you
# put in docker/.env:
# CN_MONGO_URI=mongodb://cnadmin:your-password@localhost:27017/?authSource=admin

CN_MONGO_DB_NAME=compliance_navigator
CN_CORS_ORIGINS=["http://localhost:3000"]


CN_CRAWLER_USER_AGENT=ComplianceNavigatorBot/1.0 (+contact: you@yourorg.com)
CN_CRAWLER_INTERVAL_HOURS=24

# Automatic updates: the backend crawls the official sources on this
# interval and reindexes itself. Set to false to disable and drive crawls
# externally (cron / GitHub Actions) instead.
CN_CRAWLER_AUTOSTART=true
CN_CRAWLER_STARTUP_DELAY_SECONDS=30
